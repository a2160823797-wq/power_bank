{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test:shared-serial": "node --test scripts/test-shared-serial.mjs",
    "test:device-connection": "node --test scripts/test-device-connection.mjs",
    "test:upgrade-connection": "node --test scripts/test-upgrade-connection.mjs",
    "test:ntc": "node --test scripts/test-ntc.mjs",
    "test:battery": "node --test scripts/test-battery.mjs",
    "test:iap": "node --test scripts/test-iap.mjs",
